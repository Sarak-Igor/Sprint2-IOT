# ======================================================================
# Forzy - Environment Variables Example
# Copie este arquivo para .env e preencha com seus dados.
# ======================================================================

# --- Configurações de Perfil ---
# Perfil de motor ativo para simulação (ex: motor_modelo_A, motor_modelo_B)
ACTIVE_MOTOR_PROFILE=motor_modelo_A

# --- Banco de Dados (Neon/Postgres) ---
# Formato: postgresql+asyncpg://usuario:senha@host/banco
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neondb

# --- Protocolos Industriais ---
# URL do Broker MQTT (usado para telemetria em tempo real)
MQTT_BROKER_URL=mqtt://localhost:1883

# URL do Servidor OPC UA
OPCUA_SERVER_URL=opc.tcp://localhost:4840/freeopcua/server/

# --- Cloudflare R2 Settings (Armazenamento de Manuais/Arquivos) ---
R2_ACCESS_KEY_ID=seu_access_key_id
R2_SECRET_ACCESS_KEY=sua_secret_access_key
R2_ENDPOINT_URL=https://sua_id_r2.r2.cloudflarestorage.com
R2_BUCKET_NAME=forzy-manuais

# --- Segurança e CORS ---
# Origens permitidas separadas por vírgula (use * para desenvolvimento)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Chave secreta para JWT (se aplicável no futuro)
JWT_SECRET_KEY=sarak_matrix_default_secret_key_2024

# --- Notificações (Telegram) ---
# Crie um bot no BotFather e obtenha o Token
TELEGRAM_BOT_TOKEN="seu_token_aqui"
# Envie uma mensagem para o bot e acesse https://api.telegram.org/bot<TOKEN>/getUpdates para pegar seu Chat ID
TELEGRAM_CHAT_ID="seu_chat_id"
