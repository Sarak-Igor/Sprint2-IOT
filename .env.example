# Copie para .env e preencha os valores reais. Nunca commite o .env de verdade
# (backend/shared_infra/config.py lê tudo daqui via Pydantic — Fail-Fast de Configurações).

# Seletor de Perfil: qual motor o sistema está simulando/monitorando
ACTIVE_MOTOR_PROFILE=motor_modelo_a

# Origem da Telemetria: MOCK usa o publisher Python (MqttMockProvider);
# HARDWARE desliga o publisher Python e espera o ESP32 real/Wokwi publicando
# em Forzy/telemetry/# (ver specs/specs/03-migracao-simulador-esp32.md)
SIMULATION_MODE=MOCK

# Infraestrutura de Comunicação e Persistência
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neondb
MQTT_BROKER_URL=mqtt://localhost:1883
OPCUA_SERVER_URL=opc.tcp://localhost:4840/freeopcua/server/

# Armazenamento de Arquivos (Cloudflare R2 — Manuais, Schematics e PDFs)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=forzy-manuais

# Política de CORS para o Frontend
ALLOWED_ORIGINS=*

# Notificações / Alertas (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM (OpenRouter, via LangChain) — usado por ai_enrichment/plate_llm_structurer/rag_engine.
# A lista de modelos (com fallback) NÃO é configurável por .env — vive em
# backend/shared_infra/llm_models.json, versionada no repositório.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Base de Conhecimento (RAG) — PDFs e vetor-store ChromaDB 100% locais (sem R2/nuvem)
KNOWLEDGE_STORAGE_PATH=
